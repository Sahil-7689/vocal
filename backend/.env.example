# VocalFlow Backend — Local Development Environment
# Copy this to .env and fill in the values before running npm run dev

# ── Nhost / Hasura ───────────────────────────────────────────────
NHOST_SUBDOMAIN=aczgogsmgomurtssjxok
NHOST_REGION=ap-south-1
HASURA_GRAPHQL_ENDPOINT=https://aczgogsmgomurtssjxok.graphql.ap-south-1.nhost.run/v1/graphql

# Get this from: Nhost Dashboard → your project → Settings → Hasura → Admin Secret
HASURA_GRAPHQL_ADMIN_SECRET=

# ── Server ───────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
